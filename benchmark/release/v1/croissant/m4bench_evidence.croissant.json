  "@type": "sc:Dataset",
  "name": "M4Bench per-run evidence",
  "description": "Open, sanitized per-run evidence for the M4Bench clinical EHR derivation benchmark: evaluator results, agent traces with tool outputs redacted, task instructions, network egress logs, and source-to-public hash lineage. The benchmark itself (tasks, skills, harness, evaluator) is the M4 repository, https://github.com/hannesill/m4, tag m4bench-neurips2026-camera-ready.",
  "conformsTo": [
    "http://mlcommons.org/croissant/1.0",
    "http://mlcommons.org/croissant/RAI/1.0"
  ],
  "citeAs": "Ill, H., Al Attrach, R., Fani, R., Han, A., Yamamoto, R., Moerig, M. L., Yoon, D., and Celi, L. A. M4Bench: Evaluating Procedural Specification for Clinical EHR Derivation Agents. NeurIPS 2026 Evaluations and Datasets Track.",
  "license": "https://opensource.org/licenses/MIT",
  "url": "https://huggingface.co/datasets/hannesill/m4bench-evidence",
  "version": "1.0.0",
  "datePublished": "2026-10-13",
